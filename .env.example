# Public browser configuration. Use the project URL and publishable key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server only: signs private PDF evidence after user-scoped authorization/auditing.
# Never add NEXT_PUBLIC_ to this key or commit its value.
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated modern Supabase API key named nanas_workers, for server-side worker calls.
SUPABASE_SECRET_KEY=

# Cloudinary. Keep API_SECRET server-only; never add NEXT_PUBLIC_ to it.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_signed_upload_preset
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Application origin. Use the canonical production domain in Vercel Production
# and the appropriate preview origin when validating preview metadata.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Public product configuration.
NEXT_PUBLIC_APP_NAME=Nanas
NEXT_PUBLIC_DEFAULT_CURRENCY=BSD
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Nassau
